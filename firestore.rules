rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace this placeholder with your Firebase Authentication user UID.
      return request.auth != null && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }
    match /movies/{movieId} {
      // Visitors can read published listings only. Admin can read all listings.
      allow read: if (resource.data.published == true) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.published is bool;
      allow update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }
  }
}
